{
  "name": "thirdline",
  "version": "0.7.0",
  "description": "Thirdline: design animated lower thirds and export them with alpha (ProRes 4444, WebM, PNG).",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "license": "MIT",
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "productName": "Thirdline",
  "build": {
    "appId": "app.thirdline.desktop",
    "productName": "Thirdline",
    "files": [
      "main.js",
      "live-server.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "mac": {
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "target": [
        "dmg"
      ],
      "identity": null,
      "darkModeSupport": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo"
    },
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "dmg": {
      "title": "Thirdline",
      "iconSize": 120,
      "contents": [
        {
          "x": 170,
          "y": 190
        },
        {
          "x": 430,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 600,
        "height": 400
      },
      "artifactName": "Thirdline-${version}-${arch}.${ext}"
    },
    "afterPack": "build/after-pack.js",
    "fileAssociations": [
      {
        "ext": "l3rd",
        "name": "Thirdline Project",
        "description": "Thirdline lower-third project",
        "role": "Editor",
        "icon": "build/icon.png"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cvradu/thirdline.git"
  }
}
